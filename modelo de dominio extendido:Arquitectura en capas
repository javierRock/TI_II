@startuml arquitectura-en-capas-epcc
title Arquitectura en Capas (Hexagonal / DDD)\nSistema de Gestión de Préstamos de Bienes — EPCC UNSA

' ============================ ESTILO ============================
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #555555
skinparam ArrowFontSize 10
skinparam ComponentBorderColor #444444
skinparam InterfaceBorderColor #8A5A00
skinparam PackageBorderColor #444444
skinparam nodesep 20
skinparam ranksep 45
' Opcional (mejora la legibilidad, pero es más lento al renderizar):
' skinparam linetype ortho

' ================= 1. PRESENTACIÓN (adaptadores primarios) =================
package "1 · PRESENTACIÓN  «driving adapters»" as L1 #E8F4F8 {
  component "ReservaController\nPOST   /api/v1/reservas\nDELETE /api/v1/reservas/{id}" as CtrlReserva
  component "PrestamoController\nPOST /api/v1/prestamos/{id}/entrega\nPOST /api/v1/prestamos/{id}/devolucion" as CtrlPrestamo
  component "CatalogoController\nGET /api/v1/unidades?tipo=&estado=" as CtrlCatalogo
  component "SancionController\nGET /api/v1/personas/{cui}/bloqueos" as CtrlSancion
  component "WebMapper\nRequestDTO -> Command | Query -> ResponseDTO" as WebMapper
  component "Transversal Web\nJwtSecurityFilter · @Valid (Bean Validation)\nGlobalExceptionHandler (RFC 7807)" as WebCross

  CtrlReserva   ..> WebMapper
  CtrlPrestamo  ..> WebMapper
  CtrlCatalogo  ..> WebMapper
  CtrlSancion   ..> WebMapper
}

' ======================== 2. APLICACIÓN ========================
package "2 · APLICACIÓN  (orquesta, no decide reglas)" as L2 #F0F8E8 {
  package "Comandos (escritura)" as L2C #F7FCEF {
    component "SolicitarReserva" as UcReserva
    component "ConfirmarEntrega" as UcEntrega
    component "RegistrarDevolucion" as UcDevolucion
    component "RegistrarIncidencia" as UcIncidencia
    component "LevantarBloqueo" as UcBloqueo
  }
  package "Consultas (lectura, read-model)" as L2Q #F7FCEF {
    component "ConsultarDisponibilidad" as QDisp
    component "ListarPrestamosVigentes" as QVigentes
    component "HistorialDePersona" as QHistorial
  }
  package "Reacción a eventos de dominio" as L2E #F7FCEF {
    component "AlDevolverConRetraso\n=> genera Sanción" as SubRetraso
    component "AlRegistrarSancion\n=> notifica al usuario" as SubSancion
    component "AlExpirarReserva\n=> libera UnidadFisica" as SubExpira
  }
  component "TransactionBoundary\n@Transactional + UnitOfWork\n(1 caso de uso = 1 transacción)" as AppTx
}

' ========================= 3. DOMINIO =========================
package "3 · DOMINIO  (núcleo, sin dependencias salientes)" as L3 #FFF4E8 {

  package "Agregados (raíz + invariantes)" as L3A #FFFAED {
    component "Persona\n(CUI, rol base)" as AggPersona
    component "RecordAcademico\n(matrícula vigente)" as AggAcademico
    component "TipoBien / FichaBien\n(catálogo)" as AggCatalogo
    component "UnidadFisica\n(estado: DISPONIBLE/PRESTADA/BAJA)" as AggUnidad
    component "PoliticaPrestamo\n(cupo, plazo, garantía)" as AggPolitica
    component "Reserva\n(vigencia, expiración)" as AggReserva
    component "Prestamo\n(entrega, devolución)" as AggPrestamo
    component "Garantia" as AggGarantia
    component "Incidencia\n(daño / pérdida)" as AggIncidencia
    component "Sancion\n(bloqueo temporal)" as AggSancion
  }

  package "Servicios de dominio (reglas entre agregados)" as L3S #FFF8F0 {
    component "ResolutorDePolitica\n(rol + tipoBien -> PoliticaPrestamo)" as SrvPolitica
    component "GestorDeDisponibilidad\n(evita doble asignación)" as SrvDisponibilidad
    component "VerificadorDeElegibilidad\n(matrícula + cupo + bloqueo)" as SrvElegibilidad
    component "CalculadorDeRetraso\n(días hábiles · calendario EPCC)" as SrvRetraso
    component "GeneradorDeSanciones\n(retraso/incidencia -> PeriodoBloqueo)" as SrvSanciones
  }

  package "Objetos de valor (inmutables, autovalidados)" as L3V #FFFCF9 {
    component "CUI · DocumentoIdentidad · Correo" as VoIdentidad
    component "CodigoInventario · Ubicacion" as VoInventario
    component "IntervaloPrestamo · ActaEntrega" as VoPrestamo
    component "PeriodoBloqueo · ReferenciaPolitica · Dinero" as VoSancion
  }

  package "Eventos de dominio" as L3E #FFFEF9 {
    component "ReservaSolicitada · ReservaExpirada" as EvReserva
    component "PrestamoEntregado · PrestamoDevuelto" as EvPrestamo
    component "IncidenciaRegistrada · UnidadDadaDeBaja" as EvIncidencia
    component "SancionRegistrada · BloqueoFinalizado" as EvSancion
  }

  package "Puertos de salida · Repositorios" as L3PR #FFF6E8 {
    interface "PersonaRepository" as PortPersona
    interface "UnidadFisicaRepository" as PortUnidad
    interface "PoliticaRepository" as PortPolitica
    interface "ReservaRepository" as PortReserva
    interface "PrestamoRepository" as PortPrestamo
    interface "SancionRepository" as PortSancion
    interface "UnitOfWork" as PortUow
  }

  package "Puertos de salida · Gateways" as L3PG #FFF6E8 {
    interface "SistemaAcademicoPort\nconsultarMatricula(CUI)" as PortAcademico
    interface "NotificadorPort\nnotificar(Persona, Mensaje)" as PortNotificador
    interface "RepositorioDocumentosPort\nguardarActa(PDF)" as PortDocs
    interface "EventPublisherPort\npublicar(EventoDominio)" as PortEventos
    interface "RelojPort\nahora()" as PortReloj
  }
}

' ===================== 4. INFRAESTRUCTURA =====================
package "4 · INFRAESTRUCTURA  «driven adapters»" as L4 #E8F0F8 {
  package "Persistencia (JPA / Hibernate)" as L4P #F4F8FC {
    component "PersonaJpaAdapter" as ImplPersona
    component "UnidadFisicaJpaAdapter" as ImplUnidad
    component "ReservaJpaAdapter" as ImplReserva
    component "PrestamoJpaAdapter" as ImplPrestamo
    component "SancionJpaAdapter" as ImplSancion
    component "PoliticaJpaAdapter\n(+ caché Redis)" as ImplPolitica
    component "JpaUnitOfWork" as ImplUow
    component "EntityMapper\nEntidad JPA <-> Agregado" as ImplMapper
  }
  package "Integraciones externas" as L4E #F4F8FC {
    component "SistemaAcademicoRestAdapter\n(WebClient + Resilience4j)" as AdpAcademico
    component "EmailSmtpAdapter / SmsAdapter" as AdpNotif
    component "S3StorageAdapter (MinIO)" as AdpDocs
    component "KeycloakOAuth2 / LDAP UNSA" as AdpAuth
  }
  package "Mensajería y eventos" as L4M #F4F8FC {
    component "OutboxEventPublisher\n(patrón Transactional Outbox)" as ImplPublisher
    component "RabbitMQ Broker" as Broker
  }
  package "Configuración y observabilidad" as L4C #F4F8FC {
    component "SpringBootConfiguration\n(wiring de puertos)" as Cfg
    component "Flyway (migraciones)" as Flyway
    component "SLF4J/Logback + Micrometer" as Obs
    component "SystemClockAdapter" as AdpReloj
  }
}

' ===================== 5. PERSISTENCIA =====================
package "5 · ALMACENAMIENTO" as L5 #F8F8F8 {
  database "PostgreSQL · prestamos_epcc\npersona · unidad_fisica · reserva\nprestamo · sancion · politica" as DB
  database "Tabla outbox_evento\n(event store)" as EventDB
  storage "Object Storage\nactas PDF · fotos de incidencia" as Files
}

' ================= FLUJO 1 -> 2 =================
WebMapper --> UcReserva
WebMapper --> UcEntrega
WebMapper --> UcDevolucion
WebMapper --> UcIncidencia
WebMapper --> UcBloqueo
WebMapper --> QDisp
WebMapper --> QVigentes
WebMapper --> QHistorial
AdpAuth ..> WebCross : valida token

' ================= FLUJO 2 -> 3 =================
UcReserva    --> SrvElegibilidad
UcReserva    --> SrvPolitica
UcReserva    --> SrvDisponibilidad
UcEntrega    --> AggPrestamo
UcDevolucion --> SrvRetraso
UcIncidencia --> AggIncidencia
SubRetraso   --> SrvSanciones
SubExpira    --> AggUnidad

UcReserva  ..> PortReserva
UcEntrega  ..> PortPrestamo
UcEntrega  ..> PortUnidad
UcBloqueo  ..> PortSancion
QDisp      ..> PortUnidad
QHistorial ..> PortPersona
AppTx      ..> PortUow
SubSancion ..> PortNotificador
UcEntrega  ..> PortDocs
UcDevolucion ..> PortEventos

SrvElegibilidad ..> PortAcademico
SrvElegibilidad --> AggPersona
SrvElegibilidad --> AggSancion
SrvPolitica     --> AggPolitica
SrvDisponibilidad --> AggUnidad
SrvRetraso      ..> PortReloj
SrvSanciones    --> AggSancion

' ============ RELACIONES INTERNAS DEL DOMINIO ============
AggPersona   --> VoIdentidad
AggUnidad    --> VoInventario
AggUnidad    --> AggCatalogo
AggPrestamo  --> VoPrestamo
AggPrestamo  --> AggUnidad
AggPrestamo  --> AggGarantia
AggReserva   --> AggUnidad
AggSancion   --> VoSancion
AggIncidencia --> AggPrestamo
AggPersona   --> AggAcademico

AggReserva   ..> EvReserva
AggPrestamo  ..> EvPrestamo
AggIncidencia ..> EvIncidencia
AggSancion   ..> EvSancion

' ====== INVERSIÓN DE DEPENDENCIAS: infra implementa puertos ======
ImplPersona  ..|> PortPersona
ImplUnidad   ..|> PortUnidad
ImplReserva  ..|> PortReserva
ImplPrestamo ..|> PortPrestamo
ImplSancion  ..|> PortSancion
ImplPolitica ..|> PortPolitica
ImplUow      ..|> PortUow
AdpAcademico ..|> PortAcademico
AdpNotif     ..|> PortNotificador
AdpDocs      ..|> PortDocs
ImplPublisher ..|> PortEventos
AdpReloj     ..|> PortReloj

ImplPersona  --> ImplMapper
ImplPrestamo --> ImplMapper

' ================= FLUJO 4 -> 5 =================
ImplPersona   --> DB
ImplUnidad    --> DB
ImplReserva   --> DB
ImplPrestamo  --> DB
ImplSancion   --> DB
ImplPolitica  --> DB
ImplPublisher --> EventDB
ImplPublisher --> Broker
Broker        ..> L2E : entrega asíncrona
AdpDocs       --> Files
Flyway        --> DB
Cfg           ..> L2 : inyecta implementaciones

' ========================= NOTAS =========================
note right of L3
  **Regla de dependencia**
  El dominio no importa Spring, JPA, HTTP ni JSON.
  Todo lo que necesita del exterior lo declara
  como puerto; la infraestructura lo implementa
  (flechas ..|> apuntando hacia arriba).
end note

note bottom of AggPrestamo
  **Invariantes**
  · Una UnidadFisica no puede tener dos préstamos activos.
  · No se entrega si la Persona tiene PeriodoBloqueo vigente
    o alcanzó el cupo de su PoliticaPrestamo.
  · fechaDevolucionReal >= fechaEntrega.
end note

note bottom of AggSancion
  **Invariantes**
  · Toda Sanción referencia la ReferenciaPolitica aplicada.
  · Los PeriodoBloqueo de una Persona no se solapan.
end note

legend bottom
|= Símbolo |= Significado |
| <b>--></b> | Usa / depende directamente (hacia adentro) |
| <b>..></b> | Depende de una abstracción (puerto) |
| <b>..|></b> | Implementa el puerto (inversión de dependencias) |
| <i>interface</i> | Puerto: contrato definido por el dominio |
endlegend

@enduml
