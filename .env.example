# Copiar a .env y reemplazar las contraseñas; nunca versionar credenciales reales.
# npm run db:local -- start genera una configuración local si .env no existe.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
SESSION_HOURS=8
LOGIN_LIMIT=10
PG_LOCAL_PORT=55432
LOCAL_POSTGRES_ADMIN_PASSWORD=reemplazar_admin
ADMIN_DATABASE_URL=postgresql://prestamos_local_admin:reemplazar_admin@127.0.0.1:55432/postgres
MIGRATION_DATABASE_URL=postgresql://prestamos_owner:reemplazar_owner@127.0.0.1:55432/prestamos
DATABASE_URL=postgresql://prestamos_api:reemplazar_api@127.0.0.1:55432/prestamos
TEST_MIGRATION_DATABASE_URL=postgresql://prestamos_owner:reemplazar_owner@127.0.0.1:55432/prestamos_test
TEST_DATABASE_URL=postgresql://prestamos_api:reemplazar_api@127.0.0.1:55432/prestamos_test
